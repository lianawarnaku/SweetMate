# Copy this file to `.env` (same directory) and fill in the two values from
# your Supabase project dashboard: Settings → API.
#
# `.env` is gitignored — never commit real values.
# Restart the Expo dev server after changing these; env vars are baked in at
# bundle time.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Public URL of the deployed SweetMate API server (no trailing slash). This is
# required for Google Calendar export and other server-backed features.
EXPO_PUBLIC_API_URL=https://api.your-domain.example

# Devices with the same key share one realtime household.
EXPO_PUBLIC_HOUSEHOLD_KEY=roomie-default

# Optional privacy-controlled telemetry. The SDKs remain inactive without
# these values and until the signed-in user explicitly enables each setting.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=

# Preview only: when both are set, a fresh device with no session
# auto-signs into this account instead of showing SignInScreen. Leave unset
# for real builds — never point this at a real user's credentials.
EXPO_PUBLIC_DEMO_EMAIL=
EXPO_PUBLIC_DEMO_PASSWORD=
